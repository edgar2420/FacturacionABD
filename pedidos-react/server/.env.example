# Copiar a .env y completar. El archivo .env esta ignorado por git.

# Conexion a Oracle (los mismos datos de src/java/hibernate.cfg.xml)
ORACLE_USER=abd
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=192.168.0.5:1521/PDBABD

# OBLIGATORIO en esta base. El usuario ABD tiene la contrasena guardada con
# el verificador antiguo (10G), que el modo Thin de oracledb NO soporta:
#   NJS-116: password verifier type 0x939 is not supported in Thin mode
# Indicar la ruta al Oracle Instant Client activa el modo Thick, que si lo acepta.
ORACLE_CLIENT_DIR=C:\instantclient_23_26

# Servidor
PORT=3001
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=cambiar-por-una-cadena-larga-y-aleatoria

# --- Modo desarrollo ---------------------------------------------------------
# El sistema exige que quien entra tenga fila en ABD.USUARIOS, porque de
# USUARIOS.UNI_NEG sale el almacen con el que se crea el pedido. Cuentas como
# "abd" (el duenio del esquema) no estan en esa tabla.
# Si se define ALMACEN_DEV, esas cuentas pueden entrar usando ese almacen.
# DEJAR VACIO en cualquier despliegue real.
# ALMACEN_DEV=AL-VEN-ABD-FAB
