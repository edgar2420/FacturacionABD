	<queryString>
		<![CDATA[SELECT gestion_op, periodo_op, tipo_op, numero_op, descripcion, k_pagar
  FROM ibsadm.CXC
 WHERE NRO_DEPOSITO = $P{P_DEPOSITO}
   AND PERSONA      = $P{P_CODIGO}
 ORDER BY numero_cuota]]>
