<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="billFortalezaMovil_SFE" pageWidth="612" pageHeight="792" columnWidth="598" leftMargin="7" rightMargin="7" topMargin="28" bottomMargin="28" uuid="c6337a7b-9149-4352-97dd-81389bde4635">
	<property name="ireport.zoom" value="1.6500000000000008"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="198"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\NBeans82Projects\\SMCobranzas\\web\\views\\reportes\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_ID_TRANS" class="java.lang.String">
		<defaultValueExpression><![CDATA["LWR"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT	'1028175023' NIT_FTZ,
        SF.IDTRANS,
        SF.IDEPOL,
        SF.NUMFACTURA,
        SF.SFE_CUF,
        SF.SFE_COD_CONTROL CODCONTROL,
        TO_CHAR(SF.SFE_FECHA_EMISION, 'DD/MM/YYYY') FECHA_EMISION,
        SF.TIPOTALO,
		SF.NIT,
		TRIM(SF.RAZONSOCIAL) RAZONSOCIAL,
		SF.CODCOBRADOR,
		SF.MONTO,
		SF.FECTRANS,
		'1' CANT,
        SD.IDITEM,
        SD.IDEFACT,
        SD.NUMCUOTA,
        SD.FECVENFACT,
        SD.MONTOBS MONTO_DET,
        SD.CODESTADO,
		SQ.SFE_QR_IMG CODQR,
        VP.CODPROD||'-'||VP.NUMPOL NUMPOL,
        VP.CODCLI,
        VP.codofiemi CODSUC,
        VP.CODMONEDA,
        VR.DESCPROD,
        SU.COD_USUARIO,
        SU.NOM_USUARIO||' '||SU.NOM_AP_PATERNO||' '||SU.NOM_AP_MATERNO NOMUSER,
        SU.VAL_CIUDAD,
        DI.TELEFONO NUM_TEL_TRABAJO,
        SU.VAL_DEPARTAMENTO,
        DI.DIRECCION DESC_DIRECCION_SUC,
        DECODE(SUBSTR(VP.codofiemi, 1, 2), 'LP', 'La Paz', 'SC','Santa Cruz', 'CB', 'Cochabamba','OR', 'Oruro', 'TJ', 'Tarija', 'SU','Sucre')||', '||TO_CHAR(sf.fectrans, 'DD/MM/YYYY HH24:MI:SS') LUGAR,
        DECODE(SUBSTR(VP.codofiemi, 1, 2), 'LP', 'La Paz', 'SC','Santa Cruz', 'CB', 'Cochabamba','OR', 'Oruro', 'TJ', 'Tarija', 'SU','Sucre')||' - '||SU.VAL_PAIS UBICACION,
        DECODE(SUBSTR(VP.codofiemi,1,2), 'LP','11', 'SU', '5', 'TJ','10','OR','3','SC','0','CB','4') COD_SUC_REGIONAL,
        PCK_UTILS.CUR_TO_VARCHAR(SF.MONTO) LITERAL,
        SFEF.LEYENDA DESC_LEYENDA,
        TO_CHAR(SF.SFE_FECHA_EMISION, 'HH24:MI:SS') HORA,
        SFEF.USUARIO,
        SFEF.VAL_ESTADO  EST_EMI_EDOC
  FROM SCO_FACT SF, SCO_FACT_DET SD, SCO_FACT_QR SQ, POLIZA@FSR VP, VW_PRODUCTO VR, SCO_USUARIOS SU, direcion_oficina@fsr DI, SFE_FACTURA SFEF
 WHERE SF.IDTRANS = SD.IDTRANS
   AND SF.IDTRANS = SQ.IDTRANS
   AND SF.IDEPOL  = VP.IDEPOL
   AND VP.CODPROD = VR.CODPROD
   AND SFEF.VAL_ESTADO IN ('2','8','16','17')
   AND SF.CODCOBRADOR = SU.COD_COBRADOR
   and VP.CODOFIEMI = DI.CODOFICINA
   AND SF.CODESTADO IN ('1','2','6')
   AND SFEF.IDTRANS = SF.IDTRANS
   AND SF.IDTRANS = $P{P_ID_TRANS}
 ORDER BY SF.IDTRANS, SD.IDITEM]]>
	</queryString>
