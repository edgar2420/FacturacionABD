	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\NetBeans-12.2\\workspace\\ABDFActuracion\\src\\java\\reportes\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_NUMERO" class="java.lang.String">
		<defaultValueExpression><![CDATA["1070"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_AUTORIZACION" class="java.lang.String">
		<defaultValueExpression><![CDATA["149401200087435"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select '1014883021' NIT_ABD,
       f.numero,
       f.fecha,
       f.nit,
       f.razon_social,
       f.importe,
       f.tipo,
       f.almacen,
       f.numero_orden,
       f.numero_autorizacion,
       F.DETALEE,
       q.QR,
       GS_FECHA_EMISION FECHA_EMISION ,
       f.gs_link_qr,
       f.gs_cuf,
       SUBSTR(f.gs_fecha_emision, 1,10) FECHASFE,
       SUBSTR(f.gs_fecha_emision, 12, 8) HORA,
       s.MUNICIPIO||', '||to_Char(f.fecha,'DD')||' de '||TRIM(to_char(f.fecha, 'month','nls_date_language=spanish'))||' de '||to_char(f.fecha, 'yyyy') LUGAR,
       f.login usuario,
       F.GS_LEYENDA,
       u.numero_sucursal sucursal,
       s.DIRECCION,
       s.MUNICIPIO||' - Bolivia' MUNICIPIO,
       s.TELEFONO,
       a.codigo_cliente,
       pck_utils.cur_to_varchar(f.importe) literal,
       f.gs_estado
  from facturas_DGI f, abd.facturas_qr q, usuarios u, sucursal s, IBSVENTA.facturas a
 where f.autorizacion = q.autorizacion
   and f.numero = q.numero
   and f.login = u.login
   and u.numero_sucursal = s.numero_sucursal
   and f.tipo = a.tipo
   and f.almacen = a.almacen
   and f.numero_orden = a.numero
   and f.numero_autorizacion = a.numero_orden
   and f.gs_cuf is not null --and f.gs_estado = '2'
   and f.autorizacion = $P{P_AUTORIZACION}
   and f.numero  = $P{P_NUMERO}]]>
	</queryString>
