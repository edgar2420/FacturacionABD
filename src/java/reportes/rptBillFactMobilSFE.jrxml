<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="billFortalezaMovilS" pageWidth="362" pageHeight="950" columnWidth="348" leftMargin="7" rightMargin="7" topMargin="28" bottomMargin="28" uuid="c6337a7b-9149-4352-97dd-81389bde4635">
	<property name="ireport.zoom" value="3.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="96"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\NBeans82Projects\\Billing\\web\\views\\reportes\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_ID_TRANS" class="java.lang.String">
		<defaultValueExpression><![CDATA["MnN"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT '1028175023' NIT_FTZ,
       SF.IDTRANS, SF.IDEPOL, SF.NUMFACTURA, nvl(SF.SFE_CUF,SF.NUMAUTORIZACION) AS  NUMAUTORIZACION, SF.CODCONTROL, TO_CHAR(SF.FECLIMEMISION, 'DD/MM/YYYY') FECLIMEMISION,   SF.TIPOTALO, SF.NIT, TRIM(SF.RAZONSOCIAL) RAZONSOCIAL, SF.CODCOBRADOR, SF.MONTO, SF.FECTRANS,
       '1' CANT, SD.IDITEM, SD.IDEFACT, SD.NUMCUOTA, SD.FECVENFACT, SD.MONTOBS MONTO_DET, SD.CODESTADO,
       NVL(SQ.SFE_QR_IMG,SQ.CODQR)  CODQR,
       VP.CODPROD||'-'||VP.NUMPOL NUMPOL, VP.CODCLI, VP.codofiemi CODSUC, VP.CODMONEDA,
       VR.DESCPROD,
       SU.COD_USUARIO,
       TO_CHAR(nvl(SF.SFE_FECHA_EMISION,SF.FECLIMEMISION), 'DD/MM/YYYY') FECHA_EMISION,
       SU.NOM_USUARIO||' '||SU.NOM_AP_PATERNO||' '||SU.NOM_AP_MATERNO NOMUSER,
       SU.VAL_CIUDAD,
       SU.NUM_TEL_TRABAJO,
       SU.VAL_DEPARTAMENTO,
       su.DESC_DIRECCION_SUC,
       --SU.VAL_DEPARTAMENTO ||', '||'18/09/2015 17:44:49' LUGAR,
       SU.VAL_DEPARTAMENTO ||', '||TO_CHAR(sf.fectrans, 'DD/MM/YYYY HH24:MI:SS') LUGAR,
       SU.VAL_DEPARTAMENTO||' - '||SU.VAL_PAIS UBICACION, SU.COD_SUC_REGIONAL,
       PCK_UTILS.CUR_TO_VARCHAR(SF.MONTO) LITERAL, LV.DESC_LEYENDA,
        TO_CHAR(SF.SFE_FECHA_EMISION, 'HH24:MI:SS') HORA,
        SFEF.USUARIO,
        SFEF.VAL_ESTADO  EST_EMI_EDOC
  FROM SCO_FACT SF, SCO_FACT_DET SD, SCO_FACT_QR SQ, POLIZA@FSR VP, VW_PRODUCTO VR, SCO_USUARIOS SU, SCO_DOSIFICACION_SFV SO, VW_LVAL LV, SFE_FACTURA SFEF
 WHERE SF.IDTRANS = SD.IDTRANS
   AND SF.IDTRANS = SQ.IDTRANS
   AND SFEF.IDTRANS = SF.IDTRANS
   AND SF.IDEPOL  = VP.IDEPOL
   AND VP.CODPROD = VR.CODPROD
   AND SF.CODCOBRADOR = SU.COD_COBRADOR
   AND SF.NUMAUTORIZACION = SO.NUMAUTORIZACION
   AND SO.LEY453 = LV.COD_LEYENDA(+)
   AND SF.CODESTADO IN ('1','2','6')
   AND SFEF.VAL_ESTADO IN ('2','8','16','17')
   AND SF.IDTRANS = $P{P_ID_TRANS}
 ORDER BY SF.IDTRANS, SD.IDITEM]]>
	</queryString>
