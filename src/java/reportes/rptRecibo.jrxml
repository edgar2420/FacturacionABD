	<parameter name="P_DEPOSITO" class="java.lang.String">
		<defaultValueExpression><![CDATA[121]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select p.codigo, p.nombre, p.ruc, p.pais, p.ciudad, p.contacto, p.direccion_dom, p.telefono_dom, p.ref_per1_dir email,
       r.nro_deposito, r.nom_usuario, r.fec_recibo, 'BS' moneda,r.num_monto, r.tip_pago, r.val_banco,
       INITCAP(p.ciudad)||', '||to_Char(r.fec_recibo,'DD')||' de '||TRIM(to_char(r.fec_recibo, 'month','nls_date_language=spanish'))||' de '||to_char(r.fec_recibo, 'yyyy') LUGAR,
       pck_utils.cur_to_varchar(r.num_monto) literal
  from personas p, cob_recibos r
 where p.codigo = r.cod_cliente(+)
   and r.nro_deposito = $P{P_DEPOSITO}]]>
	</queryString>
