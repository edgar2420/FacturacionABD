<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptFactRollo_subreport" language="groovy" pageWidth="339" pageHeight="100" columnWidth="339" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="0c7453e7-6c08-4ece-b3c7-dc4fef0c54ad">
	<property name="ireport.zoom" value="5.0"/>
	<property name="ireport.x" value="335"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_ALMACEN" class="java.lang.String">
		<defaultValueExpression><![CDATA["AL-VEN-ABD-CB1"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_TIPO" class="java.lang.String">
		<defaultValueExpression><![CDATA["VD1"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_NUMERO_ORDEN" class="java.lang.String">
		<defaultValueExpression><![CDATA["106198"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_NUMERO_AUTORIZACION" class="java.lang.String">
		<defaultValueExpression><![CDATA["CBB2016"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT almacen alm ,tipo,numero,numero_orden,T.DESCRIPCION ,L.UNIDAD,L.CODIGO_ITEM,
       SUM(L.CANTIDAD)  Q,
       L.PRECIO_BS PR,
       SUM(L.NETO_BS)   BS,
       SUM(L.NETO_BS)/SUM(L.CANTIDAD) PUNIT
  FROM IBSVENTA.items t, IBSVENTA.LIN_FACTURAS L
 WHERE T.CODIGO     = L.CODIGO_ITEM
   and almacen      = $P{P_ALMACEN}
   and tipo         = $P{P_TIPO}
   and numero       = $P{P_NUMERO_ORDEN}
   and numero_orden = $P{P_NUMERO_AUTORIZACION}
GROUP BY  almacen,tipo,numero,numero_orden,T.DESCRIpcion,L.UNIDAD,L.PRECIO_BS,L.CODIGO_ITEM
]]>
	</queryString>
	<field name="ALM" class="java.lang.String"/>
	<field name="TIPO" class="java.lang.String"/>
	<field name="NUMERO" class="java.lang.String"/>
	<field name="NUMERO_ORDEN" class="java.lang.String"/>
	<field name="DESCRIPCION" class="java.lang.String"/>
	<field name="UNIDAD" class="java.lang.String"/>
	<field name="CODIGO_ITEM" class="java.lang.String"/>
