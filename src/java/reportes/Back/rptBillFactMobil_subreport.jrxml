<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptBillFactMobil_subreport" language="groovy" pageWidth="339" pageHeight="55" columnWidth="339" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="0c7453e7-6c08-4ece-b3c7-dc4fef0c54ad">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_ID_TRANS" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT SD.NUMCUOTA, SD.FECVENFACT, SD.MONTOBS MONTO_DET, SD.CODESTADO,
       VP.CODPROD||'-'||VP.NUMPOL NUMPOL, VR.DESCPROD
  FROM SCO_FACT SF, SCO_FACT_DET SD, POLIZA@FSR VP, VW_PRODUCTO VR
 WHERE SF.IDTRANS = SD.IDTRANS
   AND SF.IDEPOL  = VP.IDEPOL
   AND VP.CODPROD = VR.CODPROD
   AND SF.CODESTADO IN ('1',2, 6)
   AND SF.IDTRANS = $P{P_ID_TRANS}
 ORDER BY SD.NUMCUOTA]]>
	</queryString>
	<field name="NUMCUOTA" class="java.math.BigDecimal"/>
	<field name="FECVENFACT" class="java.sql.Timestamp"/>
	<field name="MONTO_DET" class="java.math.BigDecimal"/>
	<field name="CODESTADO" class="java.math.BigDecimal"/>
	<field name="NUMPOL" class="java.lang.String"/>
	<field name="DESCPROD" class="java.lang.String"/>
