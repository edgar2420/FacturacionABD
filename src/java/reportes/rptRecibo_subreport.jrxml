	<queryString>
		<![CDATA[    SELECT gestion_op, periodo_op, tipo_op, numero_op, numero_cuota, descripcion, moneda, k_pagar, digitar_k, i_pagar, digitar_i, unineg, estado
      FROM ibsadm.CXC
      WHERE NRO_DEPOSITO = $P{P_DEPOSITO}
        AND PERSONA      = $P{P_CODIGO}
      ORDER BY numero_cuota]]>
	</queryString>
